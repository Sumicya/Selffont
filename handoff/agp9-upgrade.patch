From a1737cf7cb25d4a9826231af47269b79ab0c8ef0 Mon Sep 17 00:00:00 2001
From: Sumicya <306456895+Sumicya@users.noreply.github.com>
Date: Sat, 12 Sep 2026 02:50:58 +0000
Subject: [PATCH] Upgrade to AGP 9.3.0 + Gradle 9.5, Node 24, build-tools 36

Major toolchain bump. AGP 8.10.1 -> 9.3.0 (latest stable) with Gradle 8.11.1 ->
9.5 (AGP 9.3 requires Gradle >= 9.5). AGP 9 flips several defaults; this pure-Java
module opts out of the two that apply via the officially documented gradle.properties
flags: android.useAndroidX=false (no AndroidX deps) and android.builtInKotlin=false
(no Kotlin sources). No legacy variant API is used, so the new DSL is adopted as-is.
libxposed api stays at 102.0.0 (already the latest release). CI Node 22 -> 24
(Active LTS); SDK build-tools 35.0.0 -> 36.0.0 to match compileSdk 36.

AGP and Gradle are coupled and must land together in this one commit.

Co-authored-by: arena-agent <297053741+arena-agent@users.noreply.github.com>
---
 .github/workflows/build-mfga-xposed.yml | 4 ++--
 .github/workflows/check.yml             | 2 +-
 mfga-xposed/build.gradle.kts            | 2 +-
 mfga-xposed/gradle.properties           | 8 ++++++++
 4 files changed, 12 insertions(+), 4 deletions(-)
 create mode 100644 mfga-xposed/gradle.properties

diff --git a/.github/workflows/build-mfga-xposed.yml b/.github/workflows/build-mfga-xposed.yml
index e7088aa..8ef0bf7 100644
--- a/.github/workflows/build-mfga-xposed.yml
+++ b/.github/workflows/build-mfga-xposed.yml
@@ -24,10 +24,10 @@ jobs:
           java-version: '21'
       - uses: gradle/actions/setup-gradle@v5
         with:
-          gradle-version: '8.11.1'
+          gradle-version: '9.5'
       - uses: android-actions/setup-android@v4
       - name: Install Android 16 SDK
-        run: sdkmanager 'platforms;android-36' 'build-tools;35.0.0'
+        run: sdkmanager 'platforms;android-36' 'build-tools;36.0.0'
       - name: Test pure policies
         run: sh tests/run_java.sh
       - name: Build installable diagnostic APK
diff --git a/.github/workflows/check.yml b/.github/workflows/check.yml
index b0624df..6fe6e45 100644
--- a/.github/workflows/check.yml
+++ b/.github/workflows/check.yml
@@ -15,7 +15,7 @@ jobs:
           python-version: '3.11'
       - uses: actions/setup-node@v5
         with:
-          node-version: '22'
+          node-version: '24'
       - uses: actions/setup-java@v5
         with:
           distribution: temurin
diff --git a/mfga-xposed/build.gradle.kts b/mfga-xposed/build.gradle.kts
index 0503181..cf37549 100644
--- a/mfga-xposed/build.gradle.kts
+++ b/mfga-xposed/build.gradle.kts
@@ -1,3 +1,3 @@
 plugins {
-    id("com.android.application") version "8.10.1" apply false
+    id("com.android.application") version "9.3.0" apply false
 }
diff --git a/mfga-xposed/gradle.properties b/mfga-xposed/gradle.properties
new file mode 100644
index 0000000..3fc2750
--- /dev/null
+++ b/mfga-xposed/gradle.properties
@@ -0,0 +1,8 @@
+# AGP 9 default changes this pure-Java Xposed module opts out of. All are the
+# officially documented gradle.properties opt-outs (temporary until AGP 10).
+#
+# useAndroidX: no AndroidX dependencies here (only the libxposed compileOnly API).
+android.useAndroidX=false
+# builtInKotlin: AGP 9 turns on built-in Kotlin by default; there are no Kotlin
+# sources in this module, so keep the Kotlin toolchain out of the build.
+android.builtInKotlin=false
-- 
2.39.5

